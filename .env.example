# Agora — 환경변수 (전부 선택)
#
# 본 앱은 사용자가 UI에 API 키를 직접 입력하는 것이 기본 흐름이다.
# 아래 변수는 M0 정찰(scripts/recon/*.ts) 또는 로컬 dev 편의용이며,
# 운영 시점에는 비워둬도 된다.
#
# 사용 시 이 파일을 .env.local 로 복사 후 채운다 (gitignore 됨).
# cp .env.example .env.local
#
# 절대 .env.local 을 커밋하지 말 것.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# CLI 모드는 별도 환경변수 불요 — claude/codex/gemini 가 PATH 에 있고
# 각자의 방식으로 OAuth/구독 인증된 상태면 됨.
