# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# session logs (jsonl) — sample만 커밋
logs/*.jsonl
!logs/sample-session.jsonl

# omc 런타임 상태 (sessions/state/memory) — 추적 제외, prd/progress/notes만 커밋
.omc/sessions/
.omc/state/
.omc/project-memory.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
